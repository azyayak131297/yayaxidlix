# Database - untuk lokal pakai SQLite, ganti ke PostgreSQL untuk production
# Untuk SQLite relative path:
DATABASE_URL="file:./prisma/dev.db"
# Untuk SQLite absolute path (Windows):
# DATABASE_URL="file:D:/AI AGENT/PROJECT/idlix-db/dev.db"
# Untuk PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# TMDB API Key (gratis dari https://www.themoviedb.org/)
TMDB_API_KEY=""

# NextAuth (minimal 32 karakter acak)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (opsional, dari https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
