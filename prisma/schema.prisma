generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  image         String?
  password      String?
  watchlist     Watchlist[]
  videoProgress VideoProgress[]
  createdAt     DateTime  @default(now())
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  contentType String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model CustomContent {
  id              String    @id @default(cuid())
  title           String
  overview        String?
  posterPath      String?
  backdropPath    String?
  releaseYear     Int?
  rating          Float?
  durationMinutes Int?
  genres          String?
  type            String // "movie" atau "tv"
  seasons         Int?
  viewCount       Int      @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model VideoProgress {
  id              String   @id @default(cuid())
  userId          String
  contentId       String
  contentType     String // "movie" atau "tv"
  episodeKey      String? // untuk series: "seriesId_s1e1"
  progressSeconds Int      // posisi playback saat ini
  durationSeconds Int      // total durasi video
  updatedAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
}

model Subtitle {
  id          String   @id @default(cuid())
  contentId   String
  contentType String   // "movie" atau "tv"
  episodeKey  String?
  language    String   // contoh: "id", "en", "es"
  label       String   // contoh: "Indonesian", "English"
  url         String   // path atau URL ke file .vtt
  format      String   @default("vtt") // "vtt" atau "srt"
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}
